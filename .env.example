# Environment configuration for Orchestrated Multi-MCP AI Agent Platform
PORT=8000
HOST=127.0.0.0
DEBUG=True

# Database Configuration (SQLite by default, compatible with PostgreSQL/MySQL)
DATABASE_URL=sqlite:///./agent_platform.db

# LLM Provider Configuration
# If OPENAI_API_KEY is not set or empty, the platform automatically runs using
# its built-in deterministic, rule-based simulated LLM engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Store Directory
VECTOR_STORE_DIR=./vector_store

# Knowledge Base Root Directory
KNOWLEDGE_BASE_DIR=./knowledge

# Execution Trace & Prompt Audit Logs Directory
LOGS_DIR=./logs
